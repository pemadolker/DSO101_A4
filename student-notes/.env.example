# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to GitHub

# Your Render PostgreSQL connection string (from Render dashboard)
DATABASE_URL=postgresql://username:password@host:port/database_name

# For running tests locally — can be a separate local DB or Render test DB
TEST_DATABASE_URL=postgresql://username:password@host:port/test_database_name

# Set to 'production' on Render, 'test' during testing, 'development' locally
NODE_ENV=development

# Port (Render sets this automatically in production)
PORT=3000
